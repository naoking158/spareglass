FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium socat ca-certificates && rm -rf /var/lib/apt/lists/*
CMD ["sh", "-c", "chromium --headless=new --no-sandbox --disable-gpu --remote-debugging-port=9223 about:blank & exec socat TCP-LISTEN:9222,fork,reuseaddr TCP:127.0.0.1:9223"]
